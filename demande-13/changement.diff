+++ b/atelier/images.js
@@ -0,0 +1,256 @@
+// L'ATELIER DES IMAGES — des visuels PNG pour les publications.
+//
+// Un texte de la maison devient une image prête à publier : Facebook (1080 × 1080)
+// et Instagram (1080 × 1350). Aucun service payant : le module dessine lui-même,
+// en pur code, avec la police Inter et le logo de la maison. Le texte est blanc,
+// les mots-clés roses, le fond noir — la charte noire validée par Basile.
+//
+// Deux mondes cohabitent :
+//   · composer()  calcule tout ce qui doit être dessiné (dimensions, couleurs, lignes,
+//     mots-clés). Déterministe, sans dépendance : les cas figés la vérifient.
+//   · rendrePng()  dessine vraiment les pixels. Elle s'appuie sur @napi-rs/canvas,
+//     la librairie de dessin libre de Skia. Sans elle, composer() reste utile.
+//
+// Les couleurs viennent de la charte (briques/charte/tokens.json), déclinaison noire :
+// fond #000000, texte #ffffff, rose #ff7eb0 pour les seuls mots-clés ; jour #ededed,
+// rose #db4f8b. Une seule police, Inter (briques/charte/polices/InterVariable.woff2),
+// un seul logo, en deux encres : blanc sur fond noir, noir sur fond clair.
+
+import fs from 'node:fs';
+import path from 'node:path';
+
+// Les chemins des briques, résolus depuis ce fichier (atelier/), jamais en dur.
+const RACINE = new URL('..', import.meta.url);
+const POLICE = new URL('briques/charte/polices/InterVariable.woff2', RACINE);
+// Le « r. » de la maison, décliné : blanc pour les fonds noirs, noir pour les fonds clairs.
+// C'est le même logo, deux encres — la charte (briques/charte/) fournit les deux fichiers.
+const LOGO_BLANC = new URL('briques/charte/logos/logo-mark-blanc.png', RACINE);
+const LOGO_NOIR = new URL('briques/charte/logos/logo-mark.png', RACINE);
+
+// ── Les formats ────────────────────────────────────────────────────────────
+// Facebook : carré. Instagram : portrait 4:5. Deux seuls formats, deux tailles.
+export const FORMATS = {
+  facebook: { largeur: 1080, hauteur: 1080, nom: 'Facebook' },
+  instagram: { largeur: 1080, hauteur: 1350, nom: 'Instagram' },
+};
+
+// ── Les thèmes (déclinaison noire de la charte) ────────────────────────────
+// nuit : fond noir, texte blanc, rose #ff7eb0. jour : fond #ededed, rose #db4f8b.
+// Le rose ne sert qu'aux mots-clés, jamais au reste du texte.
+export const THEMES = {
+  nuit: { fond: '#000000', texte: '#ffffff', gris: '#9e9e9e', motCle: '#ff7eb0', trait: 'rgba(255,126,176,.28)' },
+  jour: { fond: '#ededed', texte: '#1b1b1f', gris: '#5e6167', motCle: '#db4f8b', trait: 'rgba(219,79,139,.32)' },
+};
+
+// ── Le texte et les mots-clés ──────────────────────────────────────────────
+// Un titre, un surtitre court, un texte d'appui. Les mots-clés (marqués *ici* ou
+// donnés en liste) passent seuls en rose. Règle de la maison : un mot-clé par
+// ligne de titre, en première ligne ; retenue, trois tailles de titres au plus.
+export function separerMotCle(texte) {
+  const t = String(texte || '').trim();
+  const lignes = t.split('\n').map((l) => l.trim()).filter(Boolean);
+  const motCles = [];
+  for (const m of t.matchAll(/\*([^*\n]+)\*/g)) {
+    const mot = m[1].trim();
+    if (mot && !motCles.includes(mot)) motCles.push(mot);
+  }
+  const propre = t.replace(/\*([^*\n]+)\*/g, '$1');
+  return { texte: propre, motCles, lignes: propre.split('\n').map((l) => l.trim()).filter(Boolean) };
+}
+
+// La couleur d'un texte : rose seulement si c'est un mot-clé exact, sinon blanc.
+export function couleurTexte(mot, motCles, theme) {
+  const t = THEMES[theme] || THEMES.nuit;
+  const estCle = (motCles || []).some((m) => String(m).toLowerCase() === String(mot).toLowerCase());
+  return estCle ? t.motCle : t.texte;
+}
+
+// ── La composition des lignes ──────────────────────────────────────────────
+// Le titre se découpe en lignes qui tiennent dans la largeur, à la main : ni mesure
+// de police, ni service. Largeur en pixels, corps en points, marge latérale incluse.
+const LARGEUR_GLYPHES = 0.58; // rapport largeur/corps moyen de l'Inter titrée
+
+export function decouperLignes(texte, { largeur, corps, marge }) {
+  const dispo = largeur - 2 * marge;
+  const largeurLettre = corps * LARGEUR_GLYPHES;
+  const maxLettres = Math.max(12, Math.floor(dispo / largeurLettre));
+  const mots = String(texte || '').trim().split(/\s+/).filter(Boolean);
+  const lignes = [];
+  let ligne = '';
+  for (const mot of mots) {
+    const essai = ligne ? `${ligne} ${mot}` : mot;
+    if (essai.length <= maxLettres) ligne = essai;
+    else { if (ligne) lignes.push(ligne); ligne = mot; }
+  }
+  if (ligne) lignes.push(ligne);
+  return lignes;
+}
+
+// Les deux masques du titre : le texte plein (pour la lecture) et les portions
+// roses (pour le dessin). Chaque ligne devient un tableau de segments.
+export function segmentsTitre(lignes, motCles) {
+  const tous = [];
+  for (const ligne of lignes) {
+    const segments = [];
+    // On cherche chaque mot-clé dans la ligne, en respectant la casse.
+    const positions = [];
+    for (const cle of motCles) {
+      let i = ligne.toLowerCase().indexOf(cle.toLowerCase());
+      while (i >= 0) {
+        positions.push({ debut: i, fin: i + cle.length });
+        i = ligne.toLowerCase().indexOf(cle.toLowerCase(), i + 1);
+      }
+    }
+    if (!positions.length) { segments.push({ texte: ligne, cle: false }); }
+    else {
+      positions.sort((a, b) => a.debut - b.debut);
+      let curseur = 0;
+      for (const p of positions) {
+        if (p.debut > curseur) segments.push({ texte: ligne.slice(curseur, p.debut), cle: false });
+        segments.push({ texte: ligne.slice(p.debut, p.fin), cle: true });
+        curseur = Math.max(curseur, p.fin);
+      }
+      if (curseur < ligne.length) segments.push({ texte: ligne.slice(curseur), cle: false });
+    }
+    tous.push(segments);
+  }
+  return tous;
+}
+
+// ── Les règles du visuel ───────────────────────────────────────────────────
+// Trois tailles de titres, pas une de plus. Ici : surtitre (petit), titre (grand),
+// appui (moyen). Le tout espacé sur deux repères : 16 (titre près du contenu) et 40 (groupes).
+export const CORPS = { surtitre: 34, titre: 96, appui: 46, signature: 30 };
+
+// Les dimensions de travail : marge latérale fixe, titres calés en haut, logo et
+// signature en bas. Rien ne déborde, rien ne se chevauche.
+export function composer({ surtitre = '', titre = '', appui = '', signature = 'rAIme',
+  format = 'facebook', theme = 'nuit', motCles } = {}) {
+  const dim = FORMATS[format] || FORMATS.facebook;
+  const couleurs = THEMES[theme] || THEMES.nuit;
+  const marge = Math.round(dim.largeur * 0.10);
+
+  const separe = separerMotCle(titre);
+  // Les mots-clés : la liste fournie d'abord, sinon ceux marqués *dans le titre*.
+  const cles = motCles ? [...motCles] : separe.motCles;
+  // Le titre affiché est le titre sans les astérisques de marquage.
+  const titrePropre = separe.texte;
+
+  // Le titre, découpé en lignes qui tiennent dans la largeur.
+  const lignesTitre = decouperLignes(titrePropre, { largeur: dim.largeur, corps: CORPS.titre, marge });
+
+  // Les blocs verticaux : surtitre, titre, appui, puis signature et logo en pied.
+  const ySurtitre = Math.round(dim.hauteur * 0.12);
+  const yTitre = ySurtitre + (surtitre ? CORPS.surtitre + 28 : 0);
+  const interligneTitre = Math.round(CORPS.titre * 1.18);
+  const yAppui = yTitre + lignesTitre.length * interligneTitre + 40;
+  const pied = Math.round(dim.hauteur * 0.88);
+
+  return {
+    format, theme, dim, couleurs, marge, surtitre, titre: titrePropre, appui, signature,
+    motCles: cles, lignesTitre, segments: segmentsTitre(lignesTitre, cles),
+    ySurtitre, yTitre, interligneTitre, yAppui, pied,
+  };
+}
+
+// ── Le dessin ──────────────────────────────────────────────────────────────
+let CANVAS = null;
+async function canvasMod() {
+  if (!CANVAS) CANVAS = await import('@napi-rs/canvas');
+  return CANVAS;
+}
+
+// Le rendu PNG : un fichier par visuel. La police et le logo viennent des briques.
+// Le rose ne colore que les segments marqués cle : true.
+export async function rendrePng(plan, dossier) {
+  const { createCanvas, GlobalFonts, loadImage } = await canvasMod();
+  const famille = 'InterMaison';
+  GlobalFonts.registerFromPath(POLICE.pathname, famille);
+
+  const { dim, couleurs, marge } = plan;
+  const cnv = createCanvas(dim.largeur, dim.hauteur);
+  const g = cnv.getContext('2d');
+
+  // Le fond
+  g.fillStyle = couleurs.fond;
+  g.fillRect(0, 0, dim.largeur, dim.hauteur);
+
+  // Le surtitre (gris, petites capitales espacées)
+  g.textBaseline = 'alphabetic';
+  if (plan.surtitre) {
+    g.fillStyle = couleurs.gris;
+    g.font = `500 ${CORPS.surtitre}px "${famille}"`;
+    g.letterSpacing = '2px';
+    g.fillText(plan.surtitre.toUpperCase(), marge, plan.ySurtitre + CORPS.surtitre);
+    g.letterSpacing = '0px';
+  }
+
+  // Le titre : blanc, gras ; les mots-clés en rose, italique.
+  let y = plan.yTitre;
+  for (const segments of plan.segments) {
+    g.font = `600 ${CORPS.titre}px "${famille}"`;
+    let x = marge;
+    for (const s of segments) {
+      const style = s.cle ? `italic 400 ${CORPS.titre}px "${famille}"` : `600 ${CORPS.titre}px "${famille}"`;
+      g.font = style;
+      g.fillStyle = s.cle ? couleurs.motCle : couleurs.texte;
+      if (s.texte) {
+        g.fillText(s.texte, x, y);
+        x += g.measureText(s.texte).width + Math.round(CORPS.titre * 0.18);
+      }
+    }
+    y += plan.interligneTitre;
+  }
+
+  // Le texte d'appui (moyen, gris clair)
+  if (plan.appui) {
+    g.fillStyle = couleurs.texte;
+    g.font = `400 ${CORPS.appui}px "${famille}"`;
+    g.fillText(plan.appui, marge, plan.yAppui + CORPS.appui);
+  }
+
+  // Le pied : le logo, puis la signature. Blanc sur fond noir, noir sur fond clair.
+  const logoChemin = plan.theme === 'jour' ? LOGO_NOIR : LOGO_BLANC;
+  const logo = await loadImage(logoChemin.pathname);
+  const tailleLogo = Math.round(dim.largeur * 0.11);
+  const ry = plan.pied;
+  const ratio = logo.height / logo.width;
+  g.drawImage(logo, marge, ry, tailleLogo, Math.round(tailleLogo * ratio));
+
+  g.fillStyle = couleurs.gris;
+  g.font = `500 ${CORPS.signature}px "${famille}"`;
+  g.fillText(plan.signature, marge + tailleLogo + 24, ry + Math.round(tailleLogo * ratio * 0.62));
+
+  const png = cnv.toBuffer('image/png');
+  if (dossier) {
+    fs.mkdirSync(dossier, { recursive: true });
+    fs.writeFileSync(path.join(dossier, `${plan.format}.png`), png);
+  }
+  return png;
+}
+
+// ── L'API de la maison ─────────────────────────────────────────────────────
+// fabriquerVisuel : tout en un. Retourne le plan (déterministe) et le PNG.
+export async function fabriquerVisuel(options) {
+  const plan = composer(options);
+  const png = await rendrePng(plan, options?.dossier);
+  return { plan, png };
+}
+
+// ── Ligne de commande ──────────────────────────────────────────────────────
+// node atelier/images.js --format facebook --theme nuit --titre "*Des* visuels" --appui "…"
+// Écrit le PNG dans le dossier courant, puis affiche son chemin.
+if (import.meta.url === `file://${process.argv[1]}`) {
+  const args = process.argv.slice(2);
+  const option = (n) => { const i = args.indexOf(n); return i >= 0 ? args.splice(i, 2)[1] : null; };
+  const format = option('--format') || 'facebook';
+  const theme = option('--theme') || 'nuit';
+  const surtitre = option('--surtitre') || '';
+  const titre = option('--titre') || 'Un *visuel* de la maison';
+  const appui = option('--appui') || '';
+  const signature = option('--signature') || 'rAIme';
+  const dossier = option('--dossier') || '.';
+
+  const { plan, png } = await fabriquerVisuel({ surtitre, titre, appui, signature, format, theme, dossier });
+  console.log(`${plan.format} ${plan.dim.largeur}×${plan.dim.hauteur} : ${path.join(dossier, `${plan.format}.png`)} (${png.length} octets)`);
+}
\ No newline at end of file
