+// CAS FIGÉS — LE CRÉATEUR D'IMAGES DE L'ATELIER (les visuels de publication).
+//
+// Un texte de la maison devient un visuel PNG pour Facebook (1080 × 1080) et
+// Instagram (1080 × 1350). Ce fichier verrouille ce qui ne doit jamais régresser :
+// les dimensions, la charte noire (fond noir, texte blanc, rose pour les seuls
+// mots-clés, jour #ededed et rose #db4f8b), la police Inter, le logo de la maison,
+// et le rendu réel en PNG. Tout réglage doit re-tomber ici.
+import {
+  FORMATS, THEMES, CORPS,
+  separerMotCle, couleurTexte, decouperLignes, composer, rendrePng,
+} from '../atelier/images.js';
+
+let echecs = 0;
+const KO = (m) => { echecs++; console.log(`  ECHEC ${m}`); };
+
+// 1. Les formats : deux tailles exactes, jamais d'autres
+if (FORMATS.facebook.largeur !== 1080 || FORMATS.facebook.hauteur !== 1080) KO('format facebook');
+if (FORMATS.instagram.largeur !== 1080 || FORMATS.instagram.hauteur !== 1350) KO('format instagram');
+
+// 2. Les couleurs : le rose seulement pour les mots-clés, le reste blanc
+if (couleurTexte('voiture', [], 'nuit') !== '#ffffff') KO('texte blanc');
+if (couleurTexte('voiture', ['voiture'], 'nuit') !== '#ff7eb0') KO('mot-clé nuit');
+if (couleurTexte('voiture', ['autre'], 'nuit') !== '#ffffff') KO('non mot-clé reste blanc');
+if (couleurTexte('voiture', ['voiture'], 'jour') !== '#db4f8b') KO('mot-clé jour');
+if (THEMES.nuit.fond !== '#000000') KO('fond nuit');
+if (THEMES.jour.fond !== '#ededed') KO('fond jour');
+
+// 3. La séparation des mots-clés marqués *mot*
+if (separerMotCle('Un *visuel* sobre').motCles.join(',') !== 'visuel') KO('séparation simple');
+if (separerMotCle('Sans marquage').motCles.length !== 0) KO('aucun mot-clé');
+if (separerMotCle('Une *expression* puis *une autre*').motCles.join(',') !== 'expression,une autre') KO('deux mots-clés');
+if (separerMotCle('Un *visuel* sobre').texte !== 'Un visuel sobre') KO('retrait des astérisques');
+
+// 4. Le découpage des lignes tient dans la largeur (aucun débordement)
+const titreLong = 'Construisez le site qui vend pendant que vous dormez la nuit entière sans effort';
+const lignes = decouperLignes(titreLong, { largeur: 1080, corps: 96, marge: 108 });
+for (const l of lignes) {
+  if (l.length * 96 * 0.58 > 1080 - 2 * 108) KO(`ligne trop longue : « ${l} »`);
+}
+if (lignes.length < 2) KO('le titre long doit se couper en plusieurs lignes');
+if (decouperLignes('un titre court', { largeur: 1080, corps: 96, marge: 108 }).length !== 1) KO('titre court sur une ligne');
+
+// 5. Trois tailles de titres au plus (surtitre, titre, appui ; signature en pied)
+if (Object.keys(CORPS).length !== 4) KO(`tailles de corps : ${Object.keys(CORPS).join(',')}`);
+if (!(CORPS.surtitre < CORPS.appui && CORPS.appui < CORPS.titre)) KO('hiérarchie des corps');
+
+// 6. La composition complète
+const plan = composer({ surtitre: 'rAIme', titre: 'L IA qui *travaille*', appui: 'Un visuel de la maison', format: 'facebook', theme: 'nuit' });
+if (plan.dim.largeur !== 1080 || plan.dim.hauteur !== 1080) KO('dimension composition');
+if (plan.couleurs.fond !== '#000000') KO('thème composition');
+if (plan.motCles.join(',') !== 'travaille') KO(`mots-clés composition : ${plan.motCles.join(',')}`);
+const motCleSegment = plan.segments.flat().filter((s) => s.cle).map((s) => s.texte).join(',');
+if (motCleSegment !== 'travaille') KO(`segment mot-clé : ${motCleSegment}`);
+if (plan.titre.includes('*')) KO('astérisque restant dans le titre');
+
+// 7. Le rendu réel en PNG : dimensions, fond noir, pixels blancs et roses, logo.
+//    Deux visuels : nuit, puis jour (le rose devient #db4f8b, le fond #ededed).
+async function pixelsPng(png, largeur, hauteur) {
+  const { createCanvas, loadImage } = await import('@napi-rs/canvas');
+  const cnv = createCanvas(largeur, hauteur);
+  const g = cnv.getContext('2d');
+  const img = await loadImage(Buffer.from(png));
+  g.drawImage(img, 0, 0);
+  return g.getImageData(0, 0, largeur, hauteur).data;
+}
+
+try {
+  const pngNuit = await rendrePng(plan);
+  if (pngNuit.slice(0, 8).toString('hex') !== '89504e470d0a1a0a') KO('signature PNG nuit');
+  const dNuit = await pixelsPng(pngNuit, 1080, 1080);
+  let noir = 0, blanc = 0, rose = 0;
+  for (let i = 0; i < dNuit.length; i += 4) {
+    const r = dNuit[i], gg = dNuit[i + 1], b = dNuit[i + 2];
+    if (r === 0 && gg === 0 && b === 0) noir++;
+    else if (r === 255 && gg === 255 && b === 255) blanc++;
+    else if (r === 255 && gg === 126 && b === 176) rose++;
+  }
+  if (noir === 0) KO('aucun pixel noir (fond nuit)');
+  if (blanc === 0) KO('aucun pixel blanc (texte nuit)');
+  if (rose === 0) KO('aucun pixel rose #ff7eb0 (mot-clé nuit)');
+  console.log(`  rendu nuit : noir ${noir} px · blanc ${blanc} px · rose ${rose} px`);
+
+  // Le mode jour : fond #ededed, texte sombre, mot-clé rose #db4f8b, logo noir.
+  const planJour = composer({ surtitre: 'rAIme', titre: 'Votre *outil* sur mesure', appui: 'Un service en ligne', format: 'facebook', theme: 'jour' });
+  const pngJour = await rendrePng(planJour);
+  const dJour = await pixelsPng(pngJour, 1080, 1080);
+  let fondJour = 0, roseJour = 0;
+  for (let i = 0; i < dJour.length; i += 4) {
+    const r = dJour[i], gg = dJour[i + 1], b = dJour[i + 2];
+    if (r === 237 && gg === 237 && b === 237) fondJour++;
+    else if (r === 219 && gg === 79 && b === 139) roseJour++;
+  }
+  if (fondJour === 0) KO('aucun pixel #ededed (fond jour)');
+  if (roseJour === 0) KO('aucun pixel rose #db4f8b (mot-clé jour)');
+  console.log(`  rendu jour : fond #ededed ${fondJour} px · rose ${roseJour} px`);
+} catch (e) {
+  KO(`rendu PNG : ${e.message}`);
+}
+
+console.log(echecs === 0 ? 'cas figes images : OK (formats, charte, mots-clés, rendu)' : `cas figes images : ${echecs} ECHEC(S)`);
+process.exit(echecs === 0 ? 0 : 1);
