# rAIme — execution continue des agents
# ETAT AU 25/09/2026 (verifie sur le serveur) : CE FICHIER N'EST PAS INSTALLE, et il ne doit pas l'etre.
# /etc/cron.d/raime-brain n'existe pas ; la boucle (agents/boucle.js) fait deja la supervision (4 h) et
# la mise a jour du catalogue (12 h) ; le heraut ne tourne plus depuis le 03/09 (out/heraut.log).
# L'installer lancerait ces deux taches en double. Il reste ici comme memoire de l'ancien rythme.
# INSTALLATION (ancienne commande, a ne plus lancer) :
#   ssh -i ~/.ssh/raime_vps root@2.29.6.94 'cp /opt/raime/raime-brain/cron.raime /etc/cron.d/raime-brain && chmod 0644 /etc/cron.d/raime-brain && service cron restart'
SHELL=/bin/bash
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
# Catalogue de modeles a jour (prix + nouveaux modeles) - 5h30
30 5 * * * root /opt/raime/raime-brain/run.sh "node sync/openrouter_sync.js" >> /opt/raime/raime-brain/out/sync.log 2>&1
# Reconstitution du stock d e-mails avant l envoi de 8h - 7h15
# EN PAUSE depuis le 2026-09-23, comme dans agents/boucle.js : la prospection attend que Basile
# choisisse la cible et le message. Pour la relancer : retirer le « # » de la ligne ci-dessous,
# puis réinstaller ce fichier (commande en tête).
# 15 7 * * * root /opt/raime/raime-brain/run.sh "node agents/heraut.js 14" >> /opt/raime/raime-brain/out/heraut.log 2>&1
# Supervision toutes les 4 heures : constat, decision, initiative
5 */4 * * * root /opt/raime/raime-brain/run.sh "node agents/superviseur.js" >> /opt/raime/raime-brain/out/supervision.log 2>&1
